# Evolution GO — serviços externos (PostgreSQL, RabbitMQ, AWS S3)
# Copie para .env NO MESMO DIRETÓRIO do docker-compose.my.yml e preencha.
#   cp docker/examples/.env.my.example docker/examples/.env
#   docker compose -f docker/examples/docker-compose.my.yml up -d --build

# ========================================
# APLICAÇÃO
# ========================================
CLIENT_NAME=evolution
GLOBAL_API_KEY=troque-por-uma-chave-forte-uuid
VERSION=dev
WADEBUG=INFO
WEBHOOK_URL=

# ========================================
# POSTGRESQL EXTERNO
# sslmode=disable  -> Postgres em container na mesma rede Docker (Dokploy).
#                     O tráfego não sai do host e o servidor normalmente não
#                     tem TLS habilitado; forçar require dá "server refused TLS".
# sslmode=require  -> bancos gerenciados/expostos na internet (RDS, Neon, etc).
# Os bancos evogo_auth e evogo_users são criados automaticamente no boot,
# desde que o usuário tenha permissão CREATEDB.
# ========================================
POSTGRES_AUTH_DB=postgresql://USUARIO:SENHA@HOST:5432/evogo_auth?sslmode=disable
POSTGRES_USERS_DB=postgresql://USUARIO:SENHA@HOST:5432/evogo_users?sslmode=disable
DATABASE_SAVE_MESSAGES=false

# ========================================
# RABBITMQ EXTERNO
# amqps:// = TLS (porta 5671) | amqp:// = sem TLS (porta 5672)
# vhost "/" deve ser escrito como %2F
# ========================================
AMQP_URL=amqps://USUARIO:SENHA@HOST:5671/VHOST
AMQP_GLOBAL_ENABLED=true
AMQP_GLOBAL_EVENTS=messages.upsert,messages.update,connection.update
AMQP_SPECIFIC_EVENTS=

# ========================================
# AWS S3
# Endpoint regional, sem https:// e sem o nome do bucket.
# ========================================
MINIO_ENABLED=true
S3_ENDPOINT=s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=meu-bucket-evolution
S3_ACCESS_KEY=AKIA...
S3_SECRET_KEY=...
S3_USE_SSL=true
